#!/bin/bash

_istoria() {
  local current="${COMP_WORDS[COMP_CWORD]}"
  local -a candidates=()

  if (( COMP_CWORD == 1 )); then
    case "${current}" in
      --*) candidates=(--help --version) ;;
      -*) candidates=(-h -V) ;;
      *) candidates=(search delete-last init-config backup) ;;
    esac
  else
    case "${COMP_WORDS[1]}" in
      search) _istoria_search ;;
      backup) _istoria_backup ;;
    esac
  fi

  COMPREPLY=( $(compgen -W "${candidates[*]}" -- "${current}") )

  return 0
}

# The helpers below read current and add to candidates, both local to _istoria

# The options of search not given yet, backup labels after --backup-id and modes after --search
_istoria_search() {
  local word index print_query="" prompt="" backup="" mode="" typos=""

  for (( index = 2; index < COMP_CWORD; index++ )); do
    word="${COMP_WORDS[index]}"
    case "${word}" in
      # Everything after -- is the query, and these exit before searching
      --|-h|--help|-V|--version) return ;;
      --print-query) print_query=1 ;;
      --backup) backup=1 ;;
      --typos|--no-typos) typos=1 ;;
      # Their argument is the next word, whatever it looks like: free text, a label or a mode
      --prompt|--backup-id|--search)
        case "${word}" in
          --prompt) prompt=1 ;;
          --backup-id) backup=1 ;;
          --search) mode=1 ;;
        esac
        if (( ++index == COMP_CWORD )); then
          case "${word}" in
            --backup-id) _istoria_labels ;;
            --search) candidates=(keyword prefix) ;;
          esac
          return
        fi
        ;;
    esac
  done

  # Other words are the query, free text
  [[ "${current}" == --* ]] || return

  [[ -z "${print_query}" ]] && candidates+=(--print-query)
  [[ -z "${prompt}" ]] && candidates+=(--prompt)
  # The two ways to search backups go apart
  [[ -z "${backup}" ]] && candidates+=(--backup --backup-id)
  [[ -z "${mode}" ]] && candidates+=(--search)
  # So do typos and no typos
  [[ -z "${typos}" ]] && candidates+=(--typos --no-typos)
}

# The backup commands or --host, then a label after delete, and the hosts backed up after --host
_istoria_backup() {
  if (( COMP_CWORD == 2 )); then
    case "${current}" in
      -*) candidates=(--host) ;;
      *) candidates=(list delete) ;;
    esac
  elif (( COMP_CWORD == 3 )); then
    case "${COMP_WORDS[2]}" in
      delete) _istoria_labels ;;
      --host) _istoria_hosts ;;
    esac
  fi
}

_istoria_labels() {
  candidates=( $(istoria backup list 2> /dev/null | cut -f1) )
}

_istoria_hosts() {
  candidates=( $(istoria backup list 2> /dev/null | cut -f2 | sort -u) )
}

complete -F _istoria istoria
