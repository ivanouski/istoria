#!/bin/bash

# Load from .bashrc with:
#   [[ -f ~/.istoriarc ]] && . ~/.istoriarc

[[ $- == *i* ]] || return
# bind -x sets READLINE_LINE from bash 4.0, macOS ships 3.2
(( BASH_VERSINFO[0] >= 4 )) || return
command -v istoria > /dev/null || return

__istoria_search() {
  local line status
  local -a options=(--print-query)

  # istoria shows the prompt bash just cleared, ${PS1@P} needs bash 4.4. ISTORIA_PROMPT, written
  # like PS1, shows in its place. ISTORIA_SHELL_PROMPT=false skips PS1 for ›, as PS1 runs its
  # $(...) again, slow for a git status in a big repo.
  if (( BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1] >= 404 )); then
    if [[ -n ${ISTORIA_PROMPT-} ]]; then
      options+=(--prompt "${ISTORIA_PROMPT@P}")
    elif [[ ${ISTORIA_SHELL_PROMPT-} != false ]]; then
      options+=(--prompt "${PS1@P}")
    fi
  fi

  history -a
  # HISTFILE isn't exported by default
  line=$(HISTFILE=${HISTFILE} istoria search "${options[@]}" -- "${READLINE_LINE}")
  status=$?

  # 0: picked command, 3: query left with Esc, 4: command to edit; anything else keeps the line
  if (( status == 0 || status == 3 || status == 4 )) && [[ ${line} != "${READLINE_LINE}" ]]; then
    READLINE_LINE=${line}
    READLINE_POINT=${#line}
  fi

  # A bind -x function cannot run the line, the key after it in the macro does
  if (( status == 0 )); then
    bind '"\e[9101~": accept-line'
  else
    bind '"\e[9101~": ""'
  fi
}

# Up / Down search history with istoria, Enter runs the pick. Ctrl-P / Ctrl-N still step through it.
# Up / Down run a macro of two fake keys: one opens istoria, the other runs the pick. No terminal
# sends \e[9100~ or \e[9101~, so they can't clash with real keys.
bind -x '"\e[9100~": __istoria_search'
bind '"\e[A": "\e[9100~\e[9101~"'
bind '"\eOA": "\e[9100~\e[9101~"'
bind '"\e[B": "\e[9100~\e[9101~"'
bind '"\eOB": "\e[9100~\e[9101~"'
